<Window x:Class="TerminalStudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    xmlns:local="clr-namespace:TerminalStudio"
    mc:Ignorable="d"
    Icon="pack://siteoforigin:,,,/Assets/Icon.ico"
    Title="TerminalStudio" Height="600" Width="800"
    MinHeight="400" MinWidth="600"
    Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="6"
                      CornerRadius="8"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>




    <Border x:Name="rootWindowBorder"
            Background="{StaticResource BrushBgBase}"
            BorderBrush="{StaticResource BrushBorderSubtle}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource BrushBgDeep}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="pack://siteoforigin:,,,/Assets/Icon.ico" 
                       Width="15" Height="15" 
                       Margin="10,0,8,0" 
                       VerticalAlignment="Center"
                       WindowChrome.IsHitTestVisibleInChrome="False"/>
            </StackPanel>

            <StackPanel x:Name="tabsHostContainer" 
                        Grid.Column="1" 
                        Orientation="Horizontal" 
                        VerticalAlignment="Bottom"
                        SizeChanged="TabsHostContainer_SizeChanged">
                <ScrollViewer x:Name="tabsScrollViewer"
                              Style="{StaticResource ModernTabScrollViewer}"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Bottom"
                              CanContentScroll="False"
                              PreviewMouseWheel="TabsScrollViewer_PreviewMouseWheel"
                              Background="Transparent">
                    <ItemsControl x:Name="tabsControl" VerticalAlignment="Bottom" SizeChanged="TabsControl_SizeChanged">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="tabBorder" 
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        CornerRadius="5,5,0,0" 
                                        Margin="1,0,1,0" 
                                        Padding="8,5,2,5"
                                        Height="32"
                                        MinWidth="75"
                                        MaxWidth="300"
                                        Width="{Binding CustomWidth}"
                                        BorderThickness="1,1,1,0"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="TabHeader_MouseLeftButtonDown"
                                        MouseMove="TabHeader_MouseMove"
                                        MouseLeftButtonUp="TabHeader_MouseLeftButtonUp"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="6"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock x:Name="txtTitle"
                                                   Grid.Column="0"
                                                   Text="{Binding Title}" 
                                                   FontSize="12"
                                                   Foreground="{StaticResource BrushTextDim}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" 
                                                   Margin="2,0,4,0"/>
                                        
                                        <Button Grid.Column="1"
                                                Style="{StaticResource TabButtonStyle}"
                                                Margin="1,0"
                                                Click="TabSettings_Click"
                                                Tag="{Binding}">
                                            <Path Data="{StaticResource IconSettings}" 
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Stretch="Uniform" 
                                                  Width="12" Height="12" />
                                        </Button>

                                        <Button Grid.Column="2"
                                                Style="{StaticResource TabButtonStyle}"
                                                Margin="1,0"
                                                Click="CloseTab_Click" 
                                                Tag="{Binding Id}">
                                            <Path Data="{StaticResource IconClose}" 
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Stretch="Uniform" 
                                                  Width="10" Height="10" />
                                        </Button>

                                        <Thumb Grid.Column="3"
                                               Width="6"
                                               HorizontalAlignment="Right"
                                               Cursor="SizeWE"
                                               Background="Transparent"
                                               WindowChrome.IsHitTestVisibleInChrome="True"
                                               DragDelta="TabResizeThumb_DragDelta"
                                               MouseDoubleClick="TabResizeThumb_MouseDoubleClick">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="Transparent"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="tabBorder" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource BrushBgHover}"/>
                                        <Setter TargetName="txtTitle" Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource BrushBgBase}"/>
                                        <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}"/>
                                        <Setter TargetName="txtTitle" Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border x:Name="addTabGroup" 
                        Margin="3,0,4,2"
                        VerticalAlignment="Bottom"
                        CornerRadius="4"
                        Background="Transparent"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="btnAddDefaultTab" 
                                Style="{StaticResource SplitLeftButtonStyle}"
                                Width="26" 
                                Height="28" 
                                ToolTip="New Tab (PowerShell)"
                                Click="btnAddDefaultTab_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="{StaticResource IconPlus}" 
                                  Stroke="{StaticResource BrushTextPrimary}" 
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform" 
                                  Width="11" Height="11"/>
                        </Button>

                        <Button x:Name="btnTabDropdown" 
                                Style="{StaticResource SplitRightButtonStyle}"
                                Width="18" 
                                Height="28" 
                                ToolTip="Select Profile"
                                Click="btnTabDropdown_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="{StaticResource IconChevronDown}" 
                                  Stroke="{StaticResource BrushTextMuted}" 
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform" 
                                  Width="8" Height="8"/>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_Click" ToolTip="Minimize">
                    <Path Data="{StaticResource IconMinimize}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Stretch="None"/>
                </Button>
                <Button x:Name="btnMaximize" Style="{StaticResource CaptionButtonStyle}" Click="MaximizeButton_Click" ToolTip="Maximize">
                    <Path x:Name="pathMaximize" Data="{StaticResource IconMaximize}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Stretch="None"/>
                </Button>
                <Button Style="{StaticResource CaptionCloseButtonStyle}" Click="CloseButton_Click" ToolTip="Close">
                    <Path Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Stretch="Uniform" Width="10" Height="10"/>
                </Button>
            </StackPanel>
        </Grid>

        <wv2:WebView2 x:Name="webView" 
                      Grid.Row="1"
                      HorizontalAlignment="Stretch" 
                      VerticalAlignment="Stretch" />

        <Popup x:Name="settingsPopup"
               StaysOpen="False"
               AllowsTransparency="True"
               Placement="Bottom"
               PopupAnimation="Fade">
            <Border Background="{StaticResource BrushBgBase}" 
                    BorderBrush="{StaticResource BrushBorderMid}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Width="290" 
                    Padding="14"
                    Margin="0,4,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="6" Opacity="0.5" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Tab Title" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtTabTitle" Margin="0,0,0,10"/>

                    <Separator Background="{StaticResource BrushBorderSubtle}" Margin="0,0,0,10"/>

                    <TextBlock Text="Network Mode" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cmbProxyMode" SelectionChanged="cmbProxyMode_SelectionChanged" Margin="0,0,0,10">
                        <ComboBoxItem Content="Direct (No proxy)"/>
                        <ComboBoxItem Content="Local VPN (127.0.0.1:10809)"/>
                        <ComboBoxItem Content="Custom Proxy"/>
                    </ComboBox>

                    <StackPanel x:Name="panelProxyFields">
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Proxy Address" Foreground="{StaticResource BrushTextMuted}" FontSize="11" DockPanel.Dock="Left"/>
                            <TextBlock x:Name="txtProxyStatus" Foreground="{StaticResource BrushTextDim}" FontSize="11" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                        </DockPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtProxyAddress" Grid.Column="0"/>
                            <Button x:Name="btnCheckProxy" Content="Check" 
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Grid.Column="1" 
                                    Margin="6,0,0,0" 
                                    Padding="10,4"
                                    Click="btnCheckProxy_Click"/>
                        </Grid>

                        <TextBlock Text="Exceptions (NO_PROXY)" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtNoProxy" Margin="0,0,0,14"/>
                    </StackPanel>

                    <Button x:Name="btnApplySettings" 
                            Content="Apply" 
                            Style="{StaticResource ActionButtonStyle}"
                            Height="30"
                            Click="btnApplySettings_Click"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
    </Border>
</Window>
