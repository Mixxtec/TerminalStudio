<Window x:Class="TerminalStudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    xmlns:local="clr-namespace:TerminalStudio"
    mc:Ignorable="d"
    Icon="pack://siteoforigin:,,,/Assets/Icon.ico"
    Title="TerminalStudio" Height="600" Width="800"
    MinHeight="400" MinWidth="600"
    Background="#FF1E1E1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#252526">
            <ItemsControl x:Name="tabsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#333333" CornerRadius="4" Margin="4,4,0,4" Padding="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" 
                                    Foreground="White" 
                                    VerticalAlignment="Center" 
                                    Cursor="Hand" 
                                    MouseLeftButtonDown="TabHeader_MouseLeftButtonDown"/>
                                <Button Content="×" 
                                    FontSize="16"
                                    Foreground="#AAAAAA" 
                                    Background="Transparent" 
                                    BorderThickness="0" 
                                    Margin="8"
                                    Cursor="Hand" 
                                    Click="CloseTab_Click" 
                                    Tag="{Binding Id}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button x:Name="btnAddTab" 
                    Content="+" 
                    Width="30" 
                    Height="30" 
                    Margin="5"
                    Background="Transparent"
                    Foreground="White"
                    Cursor="Hand" 
                    Click="btnAddTab_Click">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="PowerShell" Click="btnAddPowerShell_Click" />
                        <MenuItem Header="CMD" Click="btnAddCMD_Click" />
                        <MenuItem Header="WSL" Click="btnAddWSL_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </StackPanel>

        <wv2:WebView2 x:Name="webView" 
                      Grid.Row="1"
                      HorizontalAlignment="Stretch" 
                      VerticalAlignment="Stretch" />
    </Grid>
</Window>
