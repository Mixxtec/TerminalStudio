<Window x:Class="TerminalStudio.RestartConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restart Session"
        Width="380" Height="170"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Border Background="{StaticResource BrushBgSurface}"
            BorderBrush="{StaticResource BrushBorderMid}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="6" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Restart Session" Foreground="{StaticResource BrushTextPrimary}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="1" Text="Proxy settings changed. Restart session now to apply?" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" TextWrapping="Wrap"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Reject"
                        Width="85" Height="30"
                        Margin="0,0,8,0"
                        Padding="0,6"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Click="BtnReject_Click"/>
                <Button Content="Accept"
                        Width="85" Height="30"
                        Padding="0,6"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="BtnAccept_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
