<Window x:Class="TerminalStudio.RestartConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restart Session"
        Width="380" Height="170"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">
    
    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="8" Padding="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="6" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Restart Session" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="1" Text="Proxy settings changed. Restart session now to apply?" Foreground="#CCCCCC" FontSize="12" TextWrapping="Wrap"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Reject" Width="85" Margin="0,0,8,0" Padding="0,6" Background="#333333" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnReject_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Accept" Width="85" Padding="0,6" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnAccept_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
